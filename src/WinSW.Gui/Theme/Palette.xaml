<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The GUI defines its own palette rather than binding to WPF-UI's resource keys.
        Those keys move between library versions; these do not, and the whole look can be
        retuned from this one file.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#12131A" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A1B23" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#20222C" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2B2D39" />
    <SolidColorBrush x:Key="RailBrush" Color="#0E0F15" />
    <SolidColorBrush x:Key="InputBrush" Color="#101119" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2A1B1F" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B0090A10" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA1B2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#666C7E" />

    <!-- Accent -->
    <Color x:Key="AccentColorStart">#7C6CFF</Color>
    <Color x:Key="AccentColorEnd">#22D3EE</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C6CFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2352" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AccentColorStart}" />
        <GradientStop Offset="1" Color="{StaticResource AccentColorEnd}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#1E1B3A" />
        <GradientStop Offset="1" Color="#12222B" />
    </LinearGradientBrush>

    <!-- Service health -->
    <SolidColorBrush x:Key="HealthRunningBrush" Color="#34D399" />
    <SolidColorBrush x:Key="HealthStoppedBrush" Color="#7A8194" />
    <SolidColorBrush x:Key="HealthPendingBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="HealthBrokenBrush" Color="#F87171" />
    <SolidColorBrush x:Key="HealthUnknownBrush" Color="#4B5162" />

    <!-- Log severity -->
    <SolidColorBrush x:Key="LogErrorBrush" Color="#FF8A8A" />
    <SolidColorBrush x:Key="LogWarnBrush" Color="#FFCE73" />
    <SolidColorBrush x:Key="LogInfoBrush" Color="#C7CBD8" />

    <!--
        The icons come from Fluent System Icons, the font WPF-UI carries inside its own
        assembly, not from the system. Segoe Fluent Icons ships only with Windows 11 and
        Segoe MDL2 Assets only from Windows 10 and Server 2016, so on Server 2012 R2 every
        icon was blank; this one travels with the application, costs nothing it does not
        already carry, and looks the same on every Windows. Its code points are its own:
        an icon is written as the 20-pixel glyph of WPF-UI's SymbolRegular of that name.
    -->
    <FontFamily x:Key="IconFont">pack://application:,,,/Wpf.Ui;component/Resources/Fonts/#FluentSystemIcons-Regular</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!--
        Segoe UI has no CJK glyphs; naming YaHei explicitly keeps line heights stable
        when Chinese and Latin text share a line, instead of relying on per-glyph fallback.
    -->
    <FontFamily x:Key="BodyFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>

</ResourceDictionary>
