<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light counterpart of Palette.xaml. Every key here must exist there too. -->

    <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F4F8" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F1F6" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E3EB" />
    <SolidColorBrush x:Key="RailBrush" Color="#EBEDF3" />
    <SolidColorBrush x:Key="InputBrush" Color="#F7F8FB" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99F3F4F8" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1D26" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E5566" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7C8394" />

    <Color x:Key="AccentColorStart">#6A5AF9</Color>
    <Color x:Key="AccentColorEnd">#0EA5E9</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#6A5AF9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6E3FF" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AccentColorStart}" />
        <GradientStop Offset="1" Color="{StaticResource AccentColorEnd}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#ECEAFF" />
        <GradientStop Offset="1" Color="#E3F6FB" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HealthRunningBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="HealthStoppedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="HealthPendingBrush" Color="#D97706" />
    <SolidColorBrush x:Key="HealthBrokenBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="HealthUnknownBrush" Color="#9CA3AF" />

    <SolidColorBrush x:Key="LogErrorBrush" Color="#C62828" />
    <SolidColorBrush x:Key="LogWarnBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="LogInfoBrush" Color="#2A2E3A" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>

</ResourceDictionary>
