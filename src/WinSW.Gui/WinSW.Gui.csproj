<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinSW.Gui.ico</ApplicationIcon>
    <RootNamespace>WinSW.Gui</RootNamespace>
    <AssemblyName>WinSW.Gui</AssemblyName>

    <!--
      The GUI is a companion application, not part of the wrapper binary.
      Warnings here must never be able to break the build of WinSW itself,
      so the repository-wide TreatWarningsAsErrors is relaxed for this project.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!--
      The .NET desktop runtime pack carries its own framework messages translated into forty
      languages, about 15 MB of the self-contained build. They are the runtime's strings, not
      ours: this application's four languages are XAML resource dictionaries compiled into the
      assembly, so nothing user-visible depends on them.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <AssemblyTitle>Windows Service Wrapper Console</AssemblyTitle>
    <Description>A graphical front end for managing services wrapped by WinSW.</Description>
    <Product>Windows Service Wrapper</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also a resource, so the windows and the tray icon read the one file. -->
    <Resource Include="Assets\WinSW.Gui.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.1.1" />

    <!--
      The tray icon, and nothing else. TrayIcon calls Shell_NotifyIcon itself rather than
      using the Windows Forms NotifyIcon, and System.Drawing is what remains of that: it
      decodes the multi-resolution .ico and picks the frame matching the notification area's
      size, which follows the display scaling. It came in with Windows Forms before and so
      was never referenced by name.

      Dropping UseWindowsForms was expected to be worth about 15 MB of the self-contained
      build. It was worth nothing, and this reference is why the smallest build grew:

        gui-v0.11.0 -> gui-v0.12.0, release assets, bytes
          x64 self-contained         68,702,026 -> 68,712,333
          arm64 self-contained       64,897,020 -> 64,907,326
          x64 framework-dependent     7,694,865 ->  8,330,407

      UseWPF already brings in the Microsoft.WindowsDesktop.App runtime pack, and that pack
      carries Windows Forms alongside WPF. A self-contained publish with no trimming — and
      WPF cannot be trimmed — ships all of it either way, so the switch only ever governed
      what this project compiled against. Size work here has to target the runtime pack, not
      individual framework references.
    -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />

    <!-- Neither is in the shared framework; both track the target framework's major. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
  </ItemGroup>

  <!--
    The wrapper that will host the service is embedded so the wizard can install a service
    on a machine with no network and no WinSW.exe lying around. The net462 build is the one
    that fits: 0.65 MB of AnyCPU IL that runs on x86, x64 and ARM64 alike, against a .NET
    Framework every supported Windows already carries. The self-contained .NET builds are
    17 MB each and exist per architecture, and upstream ships none for ARM64 at all.

    It is a plain file reference rather than a ProjectReference because the merged executable
    is produced by a custom target in WinSW.csproj, after its build: the console's workflow
    builds that project first, and a developer building only the console simply gets a
    console whose wizard falls back to downloading the wrapper.

    A file reference carries no build order, though, and a solution build is free to run the
    two projects at once: ILMerge writing this file while csc reads it into the console is a
    locked file at best and a dead MSBuild node at worst. WinSW.sln therefore declares the
    console as depending on the wrapper, which orders solution builds without adding an
    assembly reference here.
  -->
  <PropertyGroup>
    <BundledWrapper Condition="'$(BundledWrapper)' == ''">$(ArtifactsPublishDir)WinSW-net462.exe</BundledWrapper>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(BundledWrapper)')">
    <EmbeddedResource Include="$(BundledWrapper)" LogicalName="WinSW.Gui.Wrapper.exe" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The one piece of the wrapper the console shares as source rather than as a binary. A
      <proxy> element has to expand into exactly the same variables on both sides, and the
      console deliberately references no WinSW assembly it could ask instead: see the remarks
      on ServiceConfigModel. The file is written to stand alone for this reason.
    -->
    <Compile Include="..\WinSW.Core\Configuration\ProxyConfig.cs" Link="Model\ProxyConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The configuration cheat sheet is embedded so it is readable on machines with no
      network, and so it always matches the wrapper version shipped beside it.
    -->
    <EmbeddedResource Include="..\..\docs\xml-config-cheatsheet.md" LogicalName="WinSW.Gui.Guide.en.md" WithCulture="false" />

    <!--
      WithCulture is not decoration: MSBuild reads "name.zh-CN.md" as a culture-specific
      resource and routes it into a zh-CN satellite assembly, where GetManifestResourceStream
      on this assembly can never find it. Saying the file is culture-neutral keeps it in the
      main manifest, which is where the reader looks.
    -->
    <EmbeddedResource Include="..\..\docs\xml-config-cheatsheet.zh-CN.md" LogicalName="WinSW.Gui.Guide.zh-CN.md" WithCulture="false" />
  </ItemGroup>

</Project>
