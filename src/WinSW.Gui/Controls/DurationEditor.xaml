<UserControl
    x:Class="WinSW.Gui.Controls.DurationEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <TextBox
            x:Name="Number"
            Width="90"
            AutomationProperties.Name="{DynamicResource M.Dur.Amount}"
            TextChanged="OnNumberChanged" />
        <ComboBox
            x:Name="Unit"
            Width="110"
            Margin="6,0,0,0"
            AutomationProperties.Name="{DynamicResource M.Dur.Unit}"
            SelectionChanged="OnUnitChanged" />
    </StackPanel>
</UserControl>
