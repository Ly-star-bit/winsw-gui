<ui:FluentWindow
    x:Class="WinSW.Gui.Views.DiffWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource M.Diff.Title}"
    Icon="/Assets/WinSW.Gui.ico"
    Width="980"
    Height="720"
    MinWidth="560"
    MinHeight="360"
    Background="{DynamicResource SurfaceBrush}"
    FontFamily="{DynamicResource BodyFont}"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="Close" Executed="OnClose" />
    </ui:FluentWindow.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource M.Diff.Title}" />

        <Grid Grid.Row="1" Margin="24,4,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource M.Diff.Title}" />
                <TextBlock x:Name="Subtitle" Margin="0,4,16,0" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Button
                    x:Name="RestoreButton"
                    Margin="0,0,8,0"
                    Padding="12,7"
                    Background="{DynamicResource AccentGradientBrush}"
                    Foreground="White"
                    Click="OnRestore"
                    ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Foreground="White" Style="{StaticResource Icon}" Text="&#xE81C;" />
                        <TextBlock Text="{DynamicResource M.Diff.Restore}" />
                    </StackPanel>
                </Button>
                <Button Padding="12,7" Click="OnCloseClick" Content="{DynamicResource M.Diff.Close}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="24,0,24,20" Padding="0" Style="{StaticResource Card}">
            <Grid>
                <TextBlock
                    x:Name="SameNotice"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource PageSubtitle}"
                    Text="{DynamicResource M.Diff.Same}"
                    Visibility="Collapsed" />

                <ListBox
                    x:Name="Lines"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="{DynamicResource MonoFont}"
                    FontSize="12"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,1,8,1" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Old}" />
                                <TextBlock Grid.Column="1" Margin="0,1,8,1" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding New}" />
                                <TextBlock Grid.Column="2" Margin="0,1" Text="{Binding Marker}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                    <Setter Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Added">
                                                    <Setter Property="Foreground" Value="{DynamicResource HealthRunningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Margin="0,1,12,1" Text="{Binding Text}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Gap">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
