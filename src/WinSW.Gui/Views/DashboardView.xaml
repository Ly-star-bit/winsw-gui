<UserControl
    x:Class="WinSW.Gui.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:model="clr-namespace:WinSW.Gui.Model"
    xmlns:services="clr-namespace:WinSW.Gui.Services"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One row of the service list. A row that needs attention says why in its tooltip, over the whole row; the others have none. -->
        <DataTemplate x:Key="ServiceRow" DataType="{x:Type model:ServiceEntry}">
            <Grid Background="Transparent" ToolTip="{Binding AttentionText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    Fill="{Binding Health, Converter={StaticResource HealthToBrush}}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse" BasedOn="{StaticResource HealthDot}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Health}" Value="Running">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Pulse" Storyboard="{StaticResource PulseStoryboard}" />
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Pulse" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding DisplayName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource Mono}"
                        Text="{Binding ServiceName}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--
                        Needs attention: its configuration is unusable, a program one of its runs left
                        still runs outside it, it keeps stopping or Windows is about to restart it, or it
                        is stopped with an error or though set to start automatically. The row's
                        tooltip, which this shares, names the reason.
                    -->
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource HealthBrokenBrush}"
                        Style="{StaticResource Icon}"
                        Text="&#xF869;"
                        Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Running on an older configuration than the file holds. -->
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource HealthPendingBrush}"
                        Style="{StaticResource Icon}"
                        Text="&#xF13D;"
                        ToolTip="{DynamicResource M.Dash.ConfigPending}"
                        Visibility="{Binding ConfigChangedSinceStart, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{StaticResource StatusPill}">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}"
                            Text="{Binding StatusText}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="ProcessNodeTemplate" DataType="{x:Type services:ProcessNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xE05C;" />
                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Name}" />
                <TextBlock Margin="8,0,0,0" Style="{StaticResource Mono}" Text="{Binding ProcessId}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{DynamicResource M.Dash.FilterTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20" Style="{StaticResource PageRoot}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Services}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitle}" Text="{DynamicResource S.EveryWindowsServiceOnThisMachine}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" Orientation="Horizontal">
                <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="{DynamicResource M.Dash.GroupServices}" IsChecked="{Binding GroupServices}" />
                <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="{DynamicResource M.Dash.SortByStatus}" IsChecked="{Binding SortByStatus}" />
                <ui:TextBox
                    Width="240"
                    AutomationProperties.Name="{DynamicResource S.FilterByServiceIDDisplayName}"
                    PlaceholderText="{DynamicResource M.Ph.Search}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{DynamicResource S.FilterByServiceIDDisplayName}" />
            </StackPanel>

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{Binding ReloadCommand}"
                Padding="12,7"
                ToolTip="F5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xF13D;" />
                    <TextBlock Text="{DynamicResource S.Rescan}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Stats: each card is also a filter -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18" Orientation="Horizontal">
            <Border Style="{StaticResource StatCard}" Tag="{Binding HealthFilter, Converter={StaticResource EqualityToBoolean}, ConverterParameter=all}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Managed}" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Tag="{Binding HealthFilter, Converter={StaticResource EqualityToBoolean}, ConverterParameter=running}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="running" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Running}" />
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource HealthRunningBrush}" Text="{Binding RunningCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Tag="{Binding HealthFilter, Converter={StaticResource EqualityToBoolean}, ConverterParameter=stopped}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="stopped" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Stopped}" />
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource HealthStoppedBrush}" Text="{Binding StoppedCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Tag="{Binding HealthFilter, Converter={StaticResource EqualityToBoolean}, ConverterParameter=problem}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="problem" />
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.NeedsAttention}" />
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource HealthBrokenBrush}" Text="{Binding ProblemCount}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="2">
            <!--
                The list takes two fifths of the width, between 240 and 380 px, and the detail panel
                the rest. A fixed 380 px list left the panel under 300 px on a server's 1024 px screen,
                which cut its banners and rows off; from about 1280 px up the list is as wide as it was.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="240" MaxWidth="380" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Batch toolbar: shown only while several rows are highlighted (Ctrl/Shift+click). Wrapped, for a list narrowed to its least. -->
                <Border Grid.Row="0" Margin="0,0,0,8" Padding="10,8,10,4" Style="{StaticResource Card}" Visibility="{Binding HasMultipleSelected, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel>
                        <TextBlock Margin="0,0,10,4" VerticalAlignment="Center" Style="{StaticResource PageSubtitle}" Text="{Binding SelectedCountText}" />
                        <Button Margin="0,0,6,4" Padding="10,5" Command="{Binding StartSelectedCommand}" Content="{DynamicResource S.Start}" />
                        <Button Margin="0,0,6,4" Padding="10,5" Command="{Binding StopSelectedCommand}" Content="{DynamicResource S.Stop}" />
                        <Button Margin="0,0,0,4" Padding="10,5" Command="{Binding RestartSelectedCommand}" Content="{DynamicResource S.Restart}" />
                    </WrapPanel>
                </Border>

                <ListBox
                    x:Name="ServiceList"
                    Grid.Row="1"
                    AutomationProperties.Name="{DynamicResource S.Services}"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource ServiceItem}"
                    ItemTemplate="{StaticResource ServiceRow}"
                    ItemsSource="{Binding ServicesView}"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedService}"
                    MouseDoubleClick="OnServiceDoubleClick"
                    SelectionChanged="OnServiceSelectionChanged"
                    SelectionMode="Extended">
                    <!-- Used only while the list is grouped; without it grouping would also switch virtualization off. -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="6,12,0,4" Style="{StaticResource SectionTitle}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='· {0}'}" />
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <!-- Getting started: nothing is installed yet -->
                <Border Grid.Row="1" Padding="24" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="34" Style="{StaticResource Icon}" Text="&#xE1BB;" />
                        <TextBlock Margin="0,12,0,4" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource M.Empty.Title}" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="{DynamicResource M.Empty.Body}" />
                        <Button Margin="0,16,0,8" HorizontalAlignment="Left" Padding="14,8" Background="{DynamicResource AccentGradientBrush}" Foreground="White" Command="{Binding CreateServiceCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" Foreground="White" Style="{StaticResource Icon}" Text="&#xF109;" />
                                <TextBlock Text="{DynamicResource M.Empty.Create}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Left" Padding="14,8" Command="{Binding OpenConfigFileCommand}" Content="{DynamicResource M.Empty.Open}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Detail panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="40"
                            Style="{StaticResource Icon}"
                            Text="&#xE445;" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource PageSubtitle}"
                            Text="{DynamicResource S.SelectAServiceToSeeIts}" />
                    </StackPanel>

                    <Grid DataContext="{Binding SelectedService}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <!--
                            Title and actions stay put; everything else scrolls. With the actions
                            last in a column of fixed rows, a window the size of a server's remote
                            desktop pushed them below the panel, where nothing showed they existed.
                        -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Title line -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource PageSubtitle}"
                                    Text="{Binding Description}"
                                    Visibility="{Binding Description, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Margin="0,0,7,0" Fill="{Binding Health, Converter={StaticResource HealthToBrush}}" Style="{StaticResource HealthDot}" />
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StatusText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatusPill}">
                                    <TextBlock FontSize="12" Style="{StaticResource Mono}" Text="{Binding ProcessIdText}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Actions: three primaries; everything else, destructive ones last, behind "More". Wrapped, so a narrow panel moves them down a line rather than cutting them off. -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <!-- A disabled service is not started or restarted; the tooltip says why, also while the button is greyed. -->
                            <Button
                                Style="{StaticResource ActionButton}"
                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="{Binding StartUnavailableTip}"
                                ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" Foreground="{DynamicResource HealthRunningBrush}" Style="{StaticResource Icon}" Text="&#xF605;" />
                                    <TextBlock Text="{DynamicResource S.Start}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xF72A;" />
                                    <TextBlock Text="{DynamicResource S.Stop}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Style="{StaticResource ActionButton}"
                                Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="{Binding StartUnavailableTip}"
                                ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xF13D;" />
                                    <TextBlock Text="{DynamicResource S.Restart}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding DataContext.ViewLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{DynamicResource M.Dash.DoubleClickTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xE557;" />
                                    <TextBlock Text="{DynamicResource S.Logs}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding DataContext.EditConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xF6A9;" />
                                    <TextBlock Text="{DynamicResource S.EditConfiguration}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MoreButton" Style="{StaticResource ActionButton}" Click="OnMoreClick" AutomationProperties.Name="{DynamicResource M.Dash.More}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource M.Dash.More}" />
                                    <TextBlock Margin="6,0,0,0" FontSize="10" Style="{StaticResource Icon}" Text="&#xF2A3;" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding RefreshConfigCommand}" Header="{DynamicResource S.ApplyConfig}" ToolTip="{DynamicResource S.ReApplyTheConfigurationFileTo}" />
                                        <MenuItem Command="{Binding OpenFolderCommand}" Header="{DynamicResource S.Reveal}" />
                                        <MenuItem Command="{Binding OpenWorkingDirectoryCommand}" Header="{DynamicResource M.Dash.OpenWorkingDirectory}" ToolTip="{DynamicResource M.Dash.OpenWorkingDirectoryTip}" />
                                        <MenuItem Command="{Binding ExportScriptCommand}" Header="{DynamicResource M.Dash.Export}" ToolTip="{DynamicResource M.Dash.ExportTip}" />
                                        <MenuItem Command="{Binding DiagnosticsCommand}" Header="{DynamicResource M.Dash.Diagnostics}" ToolTip="{DynamicResource M.Dash.DiagnosticsTip}" />
                                        <Separator />
                                        <MenuItem Command="{Binding KillCommand}" Foreground="{DynamicResource HealthPendingBrush}" Header="{DynamicResource S.Terminate}" ToolTip="{DynamicResource S.ForceTerminateTheServiceProcessTree}" />
                                        <MenuItem Command="{Binding UninstallCommand}" Foreground="{DynamicResource HealthBrokenBrush}" Header="{DynamicResource S.Uninstall}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>

                        <ScrollViewer x:Name="DetailScroll" Grid.Row="2" Padding="0,0,6,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel>
                                    <!-- Problem banner. A Grid like the banners below it: in a horizontal StackPanel the text was given all the width it asked for, so it never wrapped and the file name was cut off. -->
                                    <Border
                                        Margin="0,0,0,14"
                                        Padding="12,10"
                                        Background="{DynamicResource DangerSoftBrush}"
                                        BorderBrush="{DynamicResource HealthBrokenBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource HealthBrokenBrush}" Style="{StaticResource Icon}" Text="&#xF869;" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Problem}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <!-- A run's program left running, whether the service is stopped or running again beside it, or its port held by another -->
                                    <Border
                                        Margin="0,0,0,14"
                                        Padding="12,8"
                                        Background="{DynamicResource DangerSoftBrush}"
                                        BorderBrush="{DynamicResource HealthBrokenBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding HasStrayProcess, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource HealthBrokenBrush}" Style="{StaticResource Icon}" Text="&#xF869;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StrayProcessText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StrayParentText}" TextWrapping="Wrap" />
                                                <!-- Ending the program alone only has a living parent start another. -->
                                                <Button
                                                    Margin="0,6,0,2"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.EndStrayParentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Content="{Binding StrayParentActionText}"
                                                    Visibility="{Binding CanEndStrayParent, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource FieldHint}" Text="{Binding StrayHintText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <!-- Not for one of Windows' own, such as System holding a port for HTTP.sys: the banner says why instead. -->
                                            <Button
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                Padding="10,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.TerminateStrayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="{DynamicResource M.Dash.StrayAction}"
                                                Visibility="{Binding CanEndStray, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>

                                    <!-- Stopped by a failure, and Windows' recovery is about to start it again -->
                                    <Border
                                        Margin="0,0,0,14"
                                        Padding="12,8"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource HealthPendingBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding IsRestartingByRecovery, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource HealthPendingBrush}" Style="{StaticResource Icon}" Text="&#xF13D;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource M.Dash.RecoveryRestarting}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding RecoveryText}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                Padding="10,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.StopRestartingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="{DynamicResource M.Dash.StopRestarting}"
                                                ToolTip="{DynamicResource M.Dash.StopRestartingTip}" />
                                        </Grid>
                                    </Border>

                                    <!-- The file has moved on since the process started -->
                                    <Border
                                        Margin="0,0,0,14"
                                        Padding="12,8"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding ConfigChangedSinceStart, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource HealthPendingBrush}" Style="{StaticResource Icon}" Text="&#xF13D;" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource M.Dash.ConfigPending}" TextWrapping="Wrap" />
                                            <Button
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                Padding="10,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="{DynamicResource M.Dash.RestartNow}"
                                                ToolTip="{Binding StartUnavailableTip}"
                                                ToolTipService.ShowOnDisabled="True" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!--
                                    Why it stopped: both exit codes, what the System log recorded, and
                                    the end of err.log and the wrapper log since the last start. Read
                                    once per stop, for the selected service; see LoadLastStopAsync.
                                    Above the facts, where it is seen without scrolling.
                                -->
                                <Border
                                    Margin="0,0,0,16"
                                    Padding="12,10"
                                    Style="{StaticResource RowCard}"
                                    Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,2" Style="{StaticResource SectionTitle}" Text="{DynamicResource M.LastStop.Title}" />
                                        <TextBlock Margin="0,0,0,8" Style="{StaticResource FieldHint}" Text="{Binding LastStopText.Since}" Visibility="{Binding LastStopText.Since, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- What Windows recorded for the service: 1067 whenever the program ended on its own with a nonzero code, 0 when it exited with 0. -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,16,6" Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Metric.ExitCode}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                                <Run FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding LastExitCodeText, Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding LastExitCodeSystemText, Mode=OneWay}" />
                                            </TextBlock>

                                            <!-- What the program itself exited with, from the wrapper log. -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,16,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource M.LastStop.ProgramExitCode}"
                                                ToolTip="{DynamicResource M.LastStop.ProgramExitCodeTip}"
                                                Visibility="{Binding LastStopText.ProgramExitCode, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="0,0,0,6"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Style="{StaticResource Mono}"
                                                Text="{Binding LastStopText.ProgramExitCode}"
                                                ToolTip="{DynamicResource M.LastStop.ProgramExitCodeTip}"
                                                Visibility="{Binding LastStopText.ProgramExitCode, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />

                                            <!-- The service control manager's record of the stop, or that it made none. -->
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,0,16,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource M.LastStop.SystemLog}"
                                                Visibility="{Binding LastStopText, Converter={StaticResource NullToVisibility}}" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Visibility="{Binding LastStopText, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding LastStopText.EventTitle}" TextWrapping="Wrap" Visibility="{Binding LastStopText.EventTitle, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
                                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding LastStopText.EventText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource M.LastStop.Reading}" Visibility="{Binding IsReadingLastStop, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- The program's error output: uvicorn's "address already in use", a Python traceback. -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding LastStopText.ErrorHeading, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding LastStopText.ErrorHeading}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastStop.ErrorLog.Path}" />
                                            <TextBlock Margin="0,0,0,4" Style="{StaticResource FieldHint}" Text="{Binding LastStopText.ErrorNote}" Visibility="{Binding LastStopText.ErrorNote, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
                                            <TextBox
                                                MaxHeight="180"
                                                Margin="0,0,0,4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontFamily="{DynamicResource MonoFont}"
                                                FontSize="12"
                                                HorizontalScrollBarVisibility="Disabled"
                                                IsReadOnly="True"
                                                PreviewMouseWheel="OnLogBoxPreviewMouseWheel"
                                                Text="{Binding LastStopText.ErrorLines, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                VerticalScrollBarVisibility="Auto"
                                                Visibility="{Binding LastStopText.ErrorLines, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
                                        </StackPanel>

                                        <!-- The wrapper's own lines: the start, the program's exit, anything it could not do. -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding LastStopText.WrapperHeading, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding LastStopText.WrapperHeading}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastStop.WrapperLog.Path}" />
                                            <TextBlock Margin="0,0,0,4" Style="{StaticResource FieldHint}" Text="{Binding LastStopText.WrapperNote}" Visibility="{Binding LastStopText.WrapperNote, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
                                            <TextBox
                                                MaxHeight="180"
                                                Margin="0,0,0,4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontFamily="{DynamicResource MonoFont}"
                                                FontSize="12"
                                                HorizontalScrollBarVisibility="Disabled"
                                                IsReadOnly="True"
                                                PreviewMouseWheel="OnLogBoxPreviewMouseWheel"
                                                Text="{Binding LastStopText.WrapperLines, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                VerticalScrollBarVisibility="Auto"
                                                Visibility="{Binding LastStopText.WrapperLines, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />
                                        </StackPanel>

                                        <WrapPanel Margin="0,6,0,0">
                                            <Button
                                                Margin="0,0,8,0"
                                                Padding="10,4"
                                                Command="{Binding DataContext.OpenErrorLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="{DynamicResource M.LastStop.OpenErrorLog}"
                                                ToolTip="{DynamicResource M.LastStop.OpenErrorLogTip}" />
                                            <Button
                                                Padding="10,4"
                                                Command="{Binding DataContext.ReadLastStopAgainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="{DynamicResource M.LastStop.ReadAgain}"
                                                ToolTip="{DynamicResource M.LastStop.ReadAgainTip}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Facts -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                            <Setter Property="Margin" Value="0,0,16,6" />
                                        </Style>
                                    </Grid.Resources>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.ServiceID}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Mono}" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ServiceName}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S.Wrapper}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding WrapperPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WrapperPath}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource S.Configuration}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding ConfigPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigPath}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource S.StartMode}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding StartMode}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource M.Dash.OnFailure}" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,6">
                                        <TextBlock Margin="0" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding RecoveryText}" TextWrapping="Wrap" />
                                        <!-- Only when the file declares failure actions: without any, the wrapper leaves these alone. -->
                                        <TextBlock
                                            Foreground="{DynamicResource HealthPendingBrush}"
                                            Style="{StaticResource FieldHint}"
                                            Text="{Binding RecoveryDifferenceText}"
                                            Visibility="{Binding RecoveryDiffers, Converter={StaticResource BoolToVisibility}}" />
                                        <WrapPanel>
                                            <Button
                                                Margin="0,6,8,0"
                                                Padding="8,2"
                                                Command="{Binding DataContext.StopRestartingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="{DynamicResource M.Dash.StopRestarting}"
                                                ToolTip="{DynamicResource M.Dash.StopRestartingTip}"
                                                Visibility="{Binding CanStopRestarting, Converter={StaticResource BoolToVisibility}}" />
                                            <Button
                                                Margin="0,6,8,0"
                                                Padding="8,2"
                                                Command="{Binding DataContext.RestoreStartTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="{Binding DataContext.RestoreStartTypeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ToolTip="{DynamicResource M.Dash.RestoreStartTypeTip}"
                                                Visibility="{Binding DataContext.CanRestoreStartType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource S.Account}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Account}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource M.Dash.DependsOn}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding DependsOnText}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource M.Dash.DependedBy}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding DependedByText}" TextWrapping="Wrap" />

                                    <!--
                                        This row and the next are wrapped rather than in one line: on a narrow panel the
                                        line was cut off, with Upgrade, Apply and the note on a schedule that cannot be
                                        read past its edge. Gaps are on the right and below, so a wrapped line starts flush.
                                    -->
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource M.Dash.WrapperVersion}" />
                                    <WrapPanel Grid.Row="8" Grid.Column="1">
                                        <TextBlock Margin="0,0,10,6" VerticalAlignment="Center" Style="{StaticResource Mono}" Text="{Binding WrapperVersion}" />
                                        <TextBlock Margin="0,0,10,6" VerticalAlignment="Center" Style="{StaticResource FieldHint}" Text="{Binding DataContext.WrapperUpdateText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button
                                            Margin="0,0,0,6"
                                            Padding="8,2"
                                            Command="{Binding DataContext.UpgradeWrapperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="{DynamicResource M.Dash.Upgrade}"
                                            Visibility="{Binding DataContext.WrapperUpdateAvailable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>

                                    <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource M.Sched.Label}" ToolTip="{DynamicResource M.Sched.Hint}" />
                                    <WrapPanel Grid.Row="9" Grid.Column="1" ToolTip="{DynamicResource M.Sched.Hint}">
                                        <ComboBox
                                            MinWidth="130"
                                            Margin="0,0,8,6"
                                            AutomationProperties.Name="{DynamicResource M.Sched.Label}"
                                            DisplayMemberPath="Label"
                                            ItemsSource="{Binding DataContext.RestartChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            SelectedItem="{Binding DataContext.SelectedRestartChoice, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <TextBox
                                            Width="64"
                                            Margin="0,0,8,6"
                                            VerticalContentAlignment="Center"
                                            IsEnabled="{Binding DataContext.RestartTimeEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Text="{Binding DataContext.RestartTime, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Margin="0,0,10,6"
                                            Padding="10,2"
                                            Command="{Binding DataContext.ApplyRestartScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="{DynamicResource M.Sched.Apply}" />
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FieldHint}"
                                            Text="{Binding DataContext.RestartScheduleNote, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            TextWrapping="Wrap" />
                                    </WrapPanel>

                                    <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource M.Group.Label}" ToolTip="{DynamicResource M.Group.Hint}" />
                                    <ComboBox
                                        Grid.Row="10"
                                        Grid.Column="1"
                                        MinWidth="200"
                                        Margin="0,0,0,6"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="{DynamicResource M.Group.Label}"
                                        DropDownClosed="OnGroupCommit"
                                        IsEditable="True"
                                        ItemsSource="{Binding DataContext.KnownGroups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        KeyDown="OnGroupKeyDown"
                                        LostKeyboardFocus="OnGroupCommit"
                                        Text="{Binding Group, Mode=OneWay}"
                                        ToolTip="{DynamicResource M.Group.Hint}" />
                                </Grid>

                                <!--
                                    Live metrics. Wrapped rather than in columns: at a server's 1024 px the five
                                    figures and the two trends do not fit on one line, and the trends were cut off.
                                    The negative bottom margin takes back the gap under the last line of figures.
                                -->
                                <Border Margin="0,0,0,16" Padding="12,10" Style="{StaticResource RowCard}" Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Resources>
                                        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                        </Style>
                                        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontSize" Value="14" />
                                        </Style>
                                    </Border.Resources>
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,-6">
                                            <StackPanel Margin="0,0,22,6">
                                                <TextBlock Style="{StaticResource MetricLabel}" Text="{DynamicResource M.Metric.Uptime}" />
                                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding UptimeText}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,22,6">
                                                <TextBlock Style="{StaticResource MetricLabel}" Text="CPU" />
                                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CpuText}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,22,6">
                                                <TextBlock Style="{StaticResource MetricLabel}" Text="{DynamicResource M.Metric.Memory}" />
                                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding MemoryText}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,22,6">
                                                <TextBlock Style="{StaticResource MetricLabel}" Text="{DynamicResource M.Metric.Handles}" />
                                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding HandleText}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,22,6">
                                                <TextBlock Style="{StaticResource MetricLabel}" Text="{DynamicResource M.Metric.ExitCode}" />
                                                <TextBlock Style="{StaticResource MetricValue}" Text="{Binding LastExitCodeText}" />
                                            </StackPanel>
                                            <!-- CPU over the last minute and a half; memory over the last hour, for leaks. -->
                                            <StackPanel Margin="0,0,0,6" VerticalAlignment="Bottom">
                                                <Polyline
                                                    Width="140"
                                                    Height="16"
                                                    Margin="0,0,0,2"
                                                    Points="{Binding CpuHistory, Converter={StaticResource Sparkline}, ConverterParameter='140,16'}"
                                                    Stroke="{DynamicResource AccentBrush}"
                                                    StrokeLineJoin="Round"
                                                    StrokeThickness="1.5"
                                                    ToolTip="CPU" />
                                                <Polyline
                                                    Width="140"
                                                    Height="16"
                                                    Points="{Binding MemoryHistory, Converter={StaticResource Sparkline}, ConverterParameter='140,16,auto'}"
                                                    Stroke="{DynamicResource HealthRunningBrush}"
                                                    StrokeLineJoin="Round"
                                                    StrokeThickness="1.5"
                                                    ToolTip="{DynamicResource M.Metric.MemoryTrend}" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <!-- What the program and everything under the wrapper listen on; hidden while that is nothing. -->
                                        <Grid
                                            Margin="0,10,0,0"
                                            Visibility="{Binding ListeningText, Converter={StaticResource StringToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource MetricLabel}" Text="{DynamicResource M.Dash.Listening}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MetricValue}" Text="{Binding ListeningText}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Process tree -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="{DynamicResource S.ProcessTree}" />
                                    <TreeView
                                        Grid.Row="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemTemplate="{StaticResource ProcessNodeTemplate}"
                                        ItemsSource="{Binding DataContext.ProcessTreeRoots, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="True" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{DynamicResource S.TheServiceIsNotRunningSo}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ProcessTree, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status line -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                Grid.Column="0"
                Width="90"
                Height="4"
                Margin="0,0,12,0"
                VerticalAlignment="Center">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <!--
                          Indeterminate only while shown. The marquee is a storyboard that keeps
                          running while the bar is collapsed, so left at True it animated a bar
                          nobody could see for as long as the page was open.
                        -->
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="IsIndeterminate" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="IsIndeterminate" Value="True" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="IsIndeterminate" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />
        </Grid>

        <!-- Confirmation overlay -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="4"
            Margin="-28,-24,-28,-20"
            Background="{DynamicResource OverlayBrush}"
            Focusable="True"
            Visibility="{Binding ConfirmVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}" />
            </Grid.InputBindings>
            <Border
                MaxWidth="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource Card}"
                Padding="24">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ConfirmTitle}" />
                    <TextBlock Margin="0,10,0,20" Style="{StaticResource PageSubtitle}" Text="{Binding ConfirmMessage}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="ConfirmCancelButton" Margin="0,0,8,0" Padding="14,7" Command="{Binding CancelConfirmCommand}" Content="{DynamicResource S.Cancel}" />
                        <Button
                            Padding="14,7"
                            Background="{DynamicResource HealthBrokenBrush}"
                            Command="{Binding ConfirmCommand}"
                            Content="{Binding ConfirmActionLabel}"
                            Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
