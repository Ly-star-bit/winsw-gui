<UserControl
    x:Class="WinSW.Gui.Views.RemoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:RemoteViewModel}"
    mc:Ignorable="d">

    <Grid Margin="28,24,28,20" Style="{StaticResource PageRoot}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource M.Nav.Remote}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitle}" Text="{DynamicResource M.Remote.Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" Style="{StaticResource Card}">
            <!--
                Two rows. On one, the fixed columns before Start, Stop and Restart came to about
                786 px, and at 1024 px with the navigation rail expanded the card is about 700 px
                wide: the buttons were cut off. The two boxes now share what the first row leaves,
                down to a floor, and the switches and the buttons have the second row to
                themselves, about 580 px in the widest language.
            -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The floors are on the columns: a star column ignores its content's MinWidth. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Remote.Machine}" />

                <!--
                    Enter connects, from code and only with the drop-down closed: a KeyBinding
                    would take the key from an open drop-down too, and connect to the text as
                    typed instead of picking the highlighted machine. The list is the machines
                    connected to before; see RemoteViewModel.Remember for why its text needs care.
                -->
                <ComboBox
                    Grid.Column="1"
                    AutomationProperties.Name="{DynamicResource M.Remote.Machine}"
                    IsEditable="True"
                    ItemsSource="{Binding RecentMachines}"
                    PreviewKeyDown="OnMachineKeyDown"
                    Text="{Binding Machine, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{DynamicResource M.Remote.MachineTip}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Padding="12,6" Command="{Binding RefreshCommand}" Content="{DynamicResource M.Remote.Connect}" />
                <TextBlock Grid.Column="3" Margin="16,0,10,0" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Remote.Filter}" />
                <TextBox Grid.Column="4" AutomationProperties.Name="{DynamicResource M.Remote.Filter}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <CheckBox VerticalAlignment="Center" Content="{DynamicResource M.Remote.WrappersOnly}" IsChecked="{Binding WrappersOnly}" ToolTip="{DynamicResource M.Remote.WrappersOnlyTip}" />
                        <CheckBox Margin="14,0,0,0" VerticalAlignment="Center" Content="{DynamicResource M.Remote.AutoRefresh}" IsChecked="{Binding AutoRefresh}" />
                    </StackPanel>

                    <!-- On the selected service, through that machine's service control manager. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Padding="12,6" Command="{Binding StartCommand}" ToolTip="{DynamicResource M.Remote.ControlTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" Foreground="{DynamicResource HealthRunningBrush}" Style="{StaticResource Icon}" Text="&#xF605;" />
                                <TextBlock Text="{DynamicResource S.Start}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Padding="12,6" Command="{Binding StopCommand}" ToolTip="{DynamicResource M.Remote.ControlTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xF72A;" />
                                <TextBlock Text="{DynamicResource S.Stop}" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Command="{Binding RestartCommand}" ToolTip="{DynamicResource M.Remote.ControlTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xF13D;" />
                                <TextBlock Text="{DynamicResource S.Restart}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="0" Style="{StaticResource Card}">
            <ListBox
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding ServicesView}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedService}"
                VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Margin="0,0,12,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource HealthDot}">
                                        <Setter Property="Fill" Value="{DynamicResource HealthStoppedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource HealthRunningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                <Setter Property="Fill" Value="{DynamicResource HealthBrokenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Mono}" Text="{Binding ServiceName}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource StatusPill}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StatusText}" ToolTip="{Binding Error}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Width="90" Height="4" Margin="0,0,12,0" VerticalAlignment="Center" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />
        </Grid>
    </Grid>
</UserControl>
