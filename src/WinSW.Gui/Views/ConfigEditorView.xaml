<UserControl
    x:Class="WinSW.Gui.Views.ConfigEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:WinSW.Gui.Controls"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:ConfigEditorViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Content" Value="…" />
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource M.Browse}" />
        </Style>

        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="TabBody" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="4,14,12,0" />
        </Style>

        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,14,0,10" />
        </Style>

        <!-- Section header with a link into the wrapper's documentation. -->
        <DataTemplate x:Key="HelpHeader">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldHint}" Margin="0" Text="{Binding}" />
            </StackPanel>
        </DataTemplate>

        <!-- One lifecycle hook: executable, arguments, output capture. -->
        <DataTemplate x:Key="HookEditor">
            <Border Style="{StaticResource RowCard}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Executable}" />
                        <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Arguments}" />
                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Hook.Stdout}" />
                        <TextBox Text="{Binding StdoutPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Hook.Stderr}" />
                        <TextBox Text="{Binding StderrPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource RemoveButton}" Content="{DynamicResource M.Hook.Clear}" Command="{Binding DataContext.ClearHookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20" Style="{StaticResource PageRoot}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Configuration}" />
                    <Border Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatusPill}" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HealthPendingBrush}" Text="{DynamicResource S.Unsaved}" />
                    </Border>
                    <Border Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatusPill}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HealthRunningBrush}" Text="{DynamicResource S.Installed}" />
                    </Border>
                    <Button Style="{StaticResource HelpButton}" Command="{Binding OpenHelpCommand}" CommandParameter="" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Mono}" Text="{Binding FileLabel}" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <CheckBox Margin="0,0,14,0" VerticalAlignment="Center" Content="{DynamicResource S.XMLPreview}" IsChecked="{Binding ShowPreview}" />
                <Button Margin="0,0,8,0" Padding="12,7" Click="OnOpenGuide" ToolTip="{DynamicResource G.OpenGuideHint}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xE8A5;" />
                        <TextBlock Text="{DynamicResource G.OpenGuide}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,0" Padding="12,7" Command="{Binding OpenCommand}" Content="{DynamicResource S.Open}" />
                <Button Margin="0,0,8,0" Padding="12,7" Command="{Binding ReloadCommand}" Content="{DynamicResource S.Reload}" />
                <Button Margin="0,0,8,0" Padding="12,7" Command="{Binding SaveAsCommand}" Content="{DynamicResource S.SaveAs}" />
                <Button Margin="0,0,8,0" Padding="12,7" Background="{DynamicResource AccentGradientBrush}" Foreground="White" Command="{Binding SaveCommand}" ToolTip="Ctrl+S">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Foreground="White" Style="{StaticResource Icon}" Text="&#xE74E;" />
                        <TextBlock Text="{DynamicResource S.Save}" />
                    </StackPanel>
                </Button>
                <Button Padding="12,7" Command="{Binding ApplyToServiceCommand}" ToolTip="{DynamicResource S.SaveThenRunWinswRefreshAgainst}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xE895;" />
                        <TextBlock Text="{DynamicResource M.Editor.SaveAndApply}" />
                    </StackPanel>
                </Button>
                <Button Padding="12,7" Command="{Binding InstallCommand}" ToolTip="{DynamicResource M.Editor.InstallHint}" Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xE896;" />
                        <TextBlock Text="{DynamicResource M.Editor.Install}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="420" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12" Style="{StaticResource Card}">
                    <TabControl Background="Transparent" BorderThickness="0" DataContext="{Binding Model}">

                        <!-- Basics -->
                        <TabItem Header="{DynamicResource M.Tab.Basics}">
                            <ScrollViewer Style="{StaticResource TabBody}">
                                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.ServiceID}" />
                                        <TextBox Style="{StaticResource ValidatedTextBox}" Tag="{Binding FieldErrors[Id]}" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.UniqueAcrossTheMachineThisIs}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.DisplayName}" />
                                        <ui:TextBox PlaceholderText="{DynamicResource M.Ph.DisplayName}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Description}" />
                                        <TextBox AcceptsReturn="True" MinHeight="64" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Executable}" />
                                            <Button Style="{StaticResource HelpButton}" Margin="8,0,0,4" Padding="4,0" Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="executable" />
                                        </StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding DataContext.BrowseExecutableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <TextBox Style="{StaticResource ValidatedTextBox}" Tag="{Binding FieldErrors[Executable]}" Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.BASEExpandsToTheDirectoryContaining}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Arguments}" />
                                        <ui:TextBox PlaceholderText="{DynamicResource M.Ph.Arguments}" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.WorkingDirectory}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding DataContext.BrowseWorkingDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <ui:TextBox PlaceholderText="{DynamicResource S.DefaultsToTheDirectoryOfThe}" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Process & hooks -->
                        <TabItem Header="{DynamicResource M.Tab.Process}">
                            <ScrollViewer Style="{StaticResource TabBody}">
                                <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.StartArguments}" />
                                        <TextBox Text="{Binding StartArguments, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.WhenSetOverridesArgumentsForThe}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.StopExecutable}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding DataContext.BrowseStopExecutableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <TextBox Text="{Binding StopExecutable, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.StopArguments}" />
                                        <TextBox Text="{Binding StopArguments, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.SettingStopArgumentsSwitchesShutdownFrom}" />
                                    </StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.StopTimeout}" />
                                            <controls:DurationEditor Value="{Binding StopTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Foreground="{DynamicResource HealthBrokenBrush}" Text="{Binding FieldErrors[StopTimeout]}" Visibility="{Binding FieldErrors[StopTimeout], Converter={StaticResource StringToVisibility}}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.EG15Sec2Min}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Priority}" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DataContext.Priorities, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Priority}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Margin="0,0,0,10" Content="{DynamicResource S.HideTheConsoleWindowOfThe}" IsChecked="{Binding HideWindow}" />
                                    <CheckBox Margin="0,0,0,10" Content="{DynamicResource S.BeepOnShutdown}" IsChecked="{Binding BeepOnShutdown}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource Section}" Margin="0,0,0,10" Text="{DynamicResource M.Hook.Tab}" />
                                        <Button Style="{StaticResource HelpButton}" Margin="8,0,0,10" Padding="4,0" Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="prestart" />
                                    </StackPanel>
                                    <TextBlock Margin="0,0,0,12" Style="{StaticResource FieldHint}" Text="{DynamicResource M.Hook.Hint}" />
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource M.Hook.Prestart}" />
                                    <ContentControl Content="{Binding Prestart}" ContentTemplate="{StaticResource HookEditor}" />
                                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource M.Hook.Poststart}" />
                                    <ContentControl Content="{Binding Poststart}" ContentTemplate="{StaticResource HookEditor}" />
                                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource M.Hook.Prestop}" />
                                    <ContentControl Content="{Binding Prestop}" ContentTemplate="{StaticResource HookEditor}" />
                                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource M.Hook.Poststop}" />
                                    <ContentControl Content="{Binding Poststop}" ContentTemplate="{StaticResource HookEditor}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Service, account & recovery -->
                        <TabItem Header="{DynamicResource M.Tab.Service}">
                            <ScrollViewer Style="{StaticResource TabBody}">
                                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                    <StackPanel Style="{StaticResource Field}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.StartMode}" />
                                            <Button Style="{StaticResource HelpButton}" Margin="8,0,0,4" Padding="4,0" Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="startmode" />
                                        </StackPanel>
                                        <ComboBox HorizontalAlignment="Left" MinWidth="220" ItemsSource="{Binding DataContext.StartModes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding StartMode}" />
                                    </StackPanel>
                                    <CheckBox Margin="0,0,0,10" Content="{DynamicResource S.DelayedAutomaticStart}" IsChecked="{Binding DelayedAutoStart}" IsEnabled="{Binding SupportsDelayedAutoStart}" />
                                    <CheckBox Margin="0,0,0,10" Content="{DynamicResource S.AllowTheServiceToInteractWith}" IsChecked="{Binding Interactive}" />
                                    <CheckBox Margin="0,0,0,10" Content="{DynamicResource S.AcceptPreShutdownNotifications}" IsChecked="{Binding Preshutdown}" />
                                    <StackPanel Style="{StaticResource Field}" Margin="0,6,0,14">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.PreShutdownTimeout}" />
                                        <controls:DurationEditor Value="{Binding PreshutdownTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Foreground="{DynamicResource HealthBrokenBrush}" Text="{Binding FieldErrors[PreshutdownTimeout]}" Visibility="{Binding FieldErrors[PreshutdownTimeout], Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                    <CheckBox Margin="0,0,0,14" Content="{DynamicResource S.RefreshServicePropertiesAutomaticallyOnStart}" IsChecked="{Binding AutoRefresh}" />

                                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource S.Dependencies}" />
                                    <ItemsControl ItemsSource="{Binding Dependencies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowCard}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource RemoveButton}" Content="{DynamicResource S.Remove}" Command="{Binding DataContext.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <ui:TextBox PlaceholderText="{DynamicResource S.ServiceIDThatMustStartBefore}" Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left" Padding="12,6" Content="{DynamicResource S.AddDependency}" Command="{Binding DataContext.AddDependencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource S.Account}" />
                                        <Button Style="{StaticResource HelpButton}" Margin="8,14,0,10" Padding="4,0" Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="serviceaccount" />
                                    </StackPanel>
                                    <TextBlock Margin="0,0,0,12" Style="{StaticResource FieldHint}" Text="{DynamicResource S.LeaveEverythingBlankToRunAs}" />
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.UserName}" />
                                        <ui:TextBox PlaceholderText="{DynamicResource M.Ph.Account}" Text="{Binding ServiceAccountUser, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Password}" />
                                        <DockPanel>
                                            <ToggleButton x:Name="RevealAccountPassword" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,0" AutomationProperties.Name="{DynamicResource M.Reveal}" ToolTip="{DynamicResource M.Reveal}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" />
                                            </ToggleButton>
                                            <Grid>
                                                <PasswordBox controls:PasswordHelper.BoundPassword="{Binding ServiceAccountPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsChecked, ElementName=RevealAccountPassword, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <TextBox Text="{Binding ServiceAccountPassword, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsChecked, ElementName=RevealAccountPassword, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.StoredInClearTextInThe}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.PromptForCredentialsAtInstall}" />
                                        <ComboBox HorizontalAlignment="Left" MinWidth="180" SelectedValue="{Binding ServiceAccountPrompt}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="{DynamicResource S.None}" Tag="{x:Null}" />
                                            <ComboBoxItem Content="dialog" Tag="dialog" />
                                            <ComboBoxItem Content="console" Tag="console" />
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox Content="{DynamicResource S.GrantTheAccountTheLogOn}" IsChecked="{Binding AllowServiceLogon}" />

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource S.OnFailure}" />
                                        <Button Style="{StaticResource HelpButton}" Margin="8,14,0,10" Padding="4,0" Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="onfailure" />
                                    </StackPanel>
                                    <TextBlock Margin="0,0,0,10" Style="{StaticResource FieldHint}" Text="{DynamicResource S.ActionsTheServiceControlManagerTakes}" />
                                    <ItemsControl ItemsSource="{Binding FailureActions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowCard}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource RemoveButton}" Content="{DynamicResource S.Remove}" Command="{Binding DataContext.RemoveFailureActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <ComboBox Width="120" Margin="0,0,8,0" ItemsSource="{Binding DataContext.FailureActionTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Action}" />
                                                            <controls:DurationEditor Value="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left" Margin="0,0,0,14" Padding="12,6" Content="{DynamicResource S.AddAction}" Command="{Binding DataContext.AddFailureActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.ResetTheFailureCountAfter}" />
                                        <controls:DurationEditor Value="{Binding ResetFailureAfter, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Foreground="{DynamicResource HealthBrokenBrush}" Text="{Binding FieldErrors[ResetFailureAfter]}" Visibility="{Binding FieldErrors[ResetFailureAfter], Converter={StaticResource StringToVisibility}}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.Default1Day}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Logging -->
                        <TabItem Header="{DynamicResource S.Logging}">
                            <ScrollViewer Style="{StaticResource TabBody}">
                                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Mode}" />
                                                <Button Style="{StaticResource HelpButton}" Margin="8,0,0,4" Padding="4,0" Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="log" />
                                            </StackPanel>
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DataContext.LogModes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding LogMode}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.LogFileBaseName}" />
                                            <ui:TextBox PlaceholderText="{DynamicResource S.DefaultsToTheConfigurationFileName}" Text="{Binding LogName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.LogDirectory}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding DataContext.BrowseLogPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <ui:TextBox PlaceholderText="%BASE%" Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}" Visibility="{Binding UsesTimePattern, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.DatePattern}" />
                                        <TextBox Style="{StaticResource ValidatedTextBox}" Tag="{Binding FieldErrors[RollPattern]}" Text="{Binding RollPattern, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.ANETDateFormatSuchAs}" />
                                    </StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Visibility="{Binding UsesSizeThreshold, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.SizeThresholdKB}" />
                                            <TextBox Style="{StaticResource ValidatedTextBox}" Tag="{Binding FieldErrors[SizeThreshold]}" Text="{Binding SizeThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.Default1024010MB}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="{Binding UsesKeepFiles, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.FilesToKeep}" />
                                            <TextBox Style="{StaticResource ValidatedTextBox}" Tag="{Binding FieldErrors[KeepFiles]}" Text="{Binding KeepFiles, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Style="{StaticResource Field}" Visibility="{Binding UsesZipOptions, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.AutoRollAtTimeHHMm}" />
                                        <TextBox Style="{StaticResource ValidatedTextBox}" Tag="{Binding FieldErrors[AutoRollAtTime]}" Text="{Binding AutoRollAtTime, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,10,0,4" Style="{StaticResource FieldLabel}" Text="{DynamicResource S.ZipFilesOlderThanDays}" />
                                        <TextBox Style="{StaticResource ValidatedTextBox}" Tag="{Binding FieldErrors[ZipOlderThanNumDays]}" Text="{Binding ZipOlderThanNumDays, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,10,0,4" Style="{StaticResource FieldLabel}" Text="{DynamicResource S.ZipDateFormat}" />
                                        <TextBox Text="{Binding ZipDateFormat, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <CheckBox Margin="0,0,0,10" Content="{DynamicResource S.DoNotWriteStandardOutputTo}" IsChecked="{Binding OutFileDisabled}" />
                                    <CheckBox Margin="0,0,0,10" Content="{DynamicResource S.DoNotWriteStandardErrorTo}" IsChecked="{Binding ErrFileDisabled}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Environment -->
                        <TabItem Header="{DynamicResource S.Environment}">
                            <ScrollViewer Style="{StaticResource TabBody}">
                                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.EnvironmentVariables}" />
                                        <Button Style="{StaticResource HelpButton}" Margin="8,0,0,10" Padding="4,0" Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="env" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding EnvironmentVariables}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="3*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBox Grid.Column="0" PlaceholderText="{DynamicResource S.Name}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ui:TextBox Grid.Column="2" PlaceholderText="{DynamicResource S.Value}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="3" Style="{StaticResource RemoveButton}" Content="{DynamicResource S.Remove}" Command="{Binding DataContext.RemoveEnvironmentVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left" Margin="0,0,0,24" Padding="12,6" Content="{DynamicResource S.AddVariable}" Command="{Binding DataContext.AddEnvironmentVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.DownloadsBeforeStart}" />
                                    <ItemsControl ItemsSource="{Binding Downloads}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowCard}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                            <RowDefinition />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,0,6" PlaceholderText="{DynamicResource S.SourceURL}" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ui:TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,0,6" PlaceholderText="{DynamicResource S.DestinationPath}" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" />
                                                        <WrapPanel Grid.Row="2" Grid.Column="0">
                                                            <ComboBox Width="90" Margin="0,0,8,0" ItemsSource="{Binding DataContext.AuthTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Auth}" ToolTip="{DynamicResource S.Authentication}" />
                                                            <ui:TextBox Width="130" Margin="0,0,8,0" PlaceholderText="{DynamicResource S.UserBasicAuth}" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" />
                                                            <ToggleButton x:Name="RevealDownloadPassword" Margin="0,0,4,0" Padding="6,0" ToolTip="{DynamicResource M.Reveal}">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" />
                                                            </ToggleButton>
                                                            <Grid Width="130" Margin="0,0,8,0">
                                                                <PasswordBox controls:PasswordHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource S.PasswordBasicAuth}" Visibility="{Binding IsChecked, ElementName=RevealDownloadPassword, Converter={StaticResource InverseBoolToVisibility}}" />
                                                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsChecked, ElementName=RevealDownloadPassword, Converter={StaticResource BoolToVisibility}}" />
                                                            </Grid>
                                                            <ui:TextBox Width="150" Margin="0,0,8,0" PlaceholderText="{DynamicResource S.ProxyURL}" Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}" />
                                                            <CheckBox Margin="0,0,10,0" VerticalAlignment="Center" Content="{DynamicResource S.FailOnError}" IsChecked="{Binding FailOnError}" />
                                                            <CheckBox VerticalAlignment="Center" Content="{DynamicResource S.AllowBasicAuthOverHTTP}" IsChecked="{Binding UnsecureAuth}" />
                                                        </WrapPanel>
                                                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource RemoveButton}" Content="{DynamicResource S.Remove}" Command="{Binding DataContext.RemoveDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left" Margin="0,0,0,24" Padding="12,6" Content="{DynamicResource S.AddDownload}" Command="{Binding DataContext.AddDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource M.Map.Title}" />
                                    <TextBlock Margin="0,0,0,10" Style="{StaticResource FieldHint}" Text="{DynamicResource M.Map.Hint}" />
                                    <ItemsControl ItemsSource="{Binding SharedDirectories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:TextBox Grid.Column="0" PlaceholderText="N:" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource M.Map.Drive}" />
                                                        <ui:TextBox Grid.Column="2" PlaceholderText="{DynamicResource M.Map.Path}" Text="{Binding UncPath, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="3" Style="{StaticResource RemoveButton}" Content="{DynamicResource S.Remove}" Command="{Binding DataContext.RemoveMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left" Padding="12,6" Content="{DynamicResource M.Map.Add}" Command="{Binding DataContext.AddMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Advanced -->
                        <TabItem Header="{DynamicResource M.Adv.Tab}">
                            <Grid Margin="4,14,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Style="{StaticResource Field}" MaxWidth="720" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.SecurityDescriptorSDDL}" />
                                        <Button Style="{StaticResource HelpButton}" Margin="8,0,0,4" Padding="4,0" Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="securitydescriptor" />
                                    </StackPanel>
                                    <TextBox FontFamily="{DynamicResource MonoFont}" Text="{Binding SecurityDescriptor, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,6">
                                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="{DynamicResource M.Adv.Extensions}" />
                                    <Button Style="{StaticResource HelpButton}" Padding="4,0" Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="extensions" />
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource FieldHint}" Text="{DynamicResource M.Adv.Hint}" />
                                    <TextBox
                                        Grid.Row="1"
                                        AcceptsReturn="True"
                                        AcceptsTab="True"
                                        FontFamily="{DynamicResource MonoFont}"
                                        FontSize="12"
                                        HorizontalScrollBarVisibility="Auto"
                                        Style="{StaticResource ValidatedTextBox}"
                                        Tag="{Binding FieldErrors[ExtensionsXml]}"
                                        Text="{Binding ExtensionsXml, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- Try run: an expander under the form so the program can be run while editing. -->
                <Expander Grid.Row="1" Margin="0,10,0,0" IsExpanded="{Binding IsTrialRunning, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xE768;" />
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource M.Trial.Tab}" />
                            <TextBlock Margin="12,0,0,0" Style="{StaticResource PageSubtitle}" Text="{Binding TrialStatus}" />
                        </StackPanel>
                    </Expander.Header>
                    <Border Margin="0,8,0,0" Padding="12" Style="{StaticResource Card}">
                        <Grid Height="252">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Padding="12,6" Background="{DynamicResource AccentGradientBrush}" Foreground="White" Command="{Binding StartTrialCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" Foreground="White" Style="{StaticResource Icon}" Text="&#xE768;" />
                                        <TextBlock Text="{DynamicResource M.Trial.Start}" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,0" Padding="12,6" Command="{Binding StopTrialCommand}" Content="{DynamicResource S.Stop}" />
                                <Button Margin="0,0,14,0" Padding="12,6" Command="{Binding ClearTrialCommand}" Content="{DynamicResource S.Clear}" />
                                <TextBlock VerticalAlignment="Center" MaxWidth="600" Style="{StaticResource FieldHint}" Margin="0" Text="{DynamicResource M.Trial.Hint}" />
                                </StackPanel>

                                <!-- A try run is not a service run, and the gap between them is where most first starts fail. -->
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{DynamicResource M.Trial.Differs}" />
                            </StackPanel>
                            <Border Grid.Row="1" Padding="0" Background="{DynamicResource InputBrush}" Style="{StaticResource Card}">
                                <ListBox
                                    x:Name="TrialOutputList"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="{DynamicResource MonoFont}"
                                    FontSize="12"
                                    ItemsSource="{Binding TrialOutput}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="12,1" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{Binding Converter={StaticResource LogSeverityToBrush}}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>
                </Expander>
            </Grid>

            <!-- Resizable divider -->
            <GridSplitter
                Grid.Column="1"
                Width="8"
                Margin="4,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}" />

            <!-- Preview / raw XML -->
            <Border
                Grid.Column="2"
                Padding="0"
                Background="{DynamicResource InputBrush}"
                Style="{StaticResource Card}"
                Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,10,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Margin="0" Text="{DynamicResource S.WhatWillBeWritten}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Padding="8,3" Click="OnOpenGuide" Content="{DynamicResource G.OpenGuideShort}" ToolTip="{DynamicResource G.OpenGuideHint}" />
                            <Button Padding="8,3" Command="{Binding EnterXmlEditCommand}" Content="{DynamicResource M.Editor.EditXml}" Visibility="{Binding IsXmlEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button Margin="0,0,6,0" Padding="8,3" Background="{DynamicResource AccentGradientBrush}" Foreground="White" Command="{Binding ApplyXmlCommand}" Content="{DynamicResource M.Editor.ApplyXml}" Visibility="{Binding IsXmlEditing, Converter={StaticResource BoolToVisibility}}" />
                            <Button Padding="8,3" Command="{Binding CancelXmlEditCommand}" Content="{DynamicResource S.Cancel}" Visibility="{Binding IsXmlEditing, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <TextBox
                        Grid.Row="1"
                        Margin="6,4,6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="{DynamicResource MonoFont}"
                        FontSize="12"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        Text="{Binding XmlPreview, Mode=OneWay}"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsXmlEditing, Converter={StaticResource InverseBoolToVisibility}}" />

                    <TextBox
                        Grid.Row="1"
                        Margin="6,4,6,0"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        FontFamily="{DynamicResource MonoFont}"
                        FontSize="12"
                        HorizontalScrollBarVisibility="Auto"
                        Text="{Binding XmlEditorText, UpdateSourceTrigger=PropertyChanged}"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsXmlEditing, Converter={StaticResource BoolToVisibility}}" />

                    <Border
                        Grid.Row="2"
                        Margin="10,10,10,0"
                        Padding="12,10"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource HealthPendingBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding Warnings.Count, Converter={StaticResource CountToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border
                        Grid.Row="3"
                        Margin="10"
                        Padding="12,10"
                        Background="{DynamicResource DangerSoftBrush}"
                        BorderBrush="{DynamicResource HealthBrokenBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding Problems.Count, Converter={StaticResource CountToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
