<ui:FluentWindow
    x:Class="WinSW.Gui.Views.XmlGuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource G.Title}"
    Icon="/Assets/WinSW.Gui.ico"
    Width="1100"
    Height="800"
    MinWidth="720"
    MinHeight="480"
    Background="{DynamicResource SurfaceBrush}"
    FontFamily="{DynamicResource BodyFont}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
        <KeyBinding Key="F" Modifiers="Control" Command="Find" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="Close" Executed="OnClose" />
        <CommandBinding Command="Find" Executed="OnFind" />
    </ui:FluentWindow.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource G.Title}" />

        <!-- Header: what this page is for, and every way to take it elsewhere. -->
        <Grid Grid.Row="1" Margin="24,4,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource G.Title}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitle}" Text="{DynamicResource G.Subtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="12,7"
                    Background="{DynamicResource AccentGradientBrush}"
                    Foreground="White"
                    Click="OnCopyPrompt"
                    ToolTip="{DynamicResource G.CopyPromptHint}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Foreground="White" Style="{StaticResource Icon}" Text="&#xE945;" />
                        <TextBlock Text="{DynamicResource G.CopyPrompt}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,0" Padding="12,7" Click="OnCopyAll" Content="{DynamicResource G.CopyAll}" />
                <Button Margin="0,0,8,0" Padding="12,7" Click="OnSaveAs" Content="{DynamicResource S.SaveAs}" />
                <Button Padding="12,7" Click="OnOpenOnline" Content="{DynamicResource G.Online}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Contents -->
            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <ui:TextBox
                        x:Name="SearchBox"
                        DockPanel.Dock="Top"
                        Margin="0,0,0,10"
                        PlaceholderText="{DynamicResource G.SearchToc}"
                        TextChanged="OnSearchChanged" />
                    <ListBox
                        x:Name="Contents"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionChanged="OnHeadingPicked"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="{Binding Indent}"
                                    Opacity="{Binding Weight}"
                                    Text="{Binding Text}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="10"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch" />

            <!-- Document -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <FlowDocumentScrollViewer
                        x:Name="Viewer"
                        IsToolBarVisible="False"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" />

                    <!-- Transient confirmation for the copy buttons. -->
                    <Border
                        x:Name="Toast"
                        Margin="0,0,0,22"
                        Padding="16,9"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource AccentGradientBrush}"
                        CornerRadius="18"
                        Opacity="0"
                        IsHitTestVisible="False">
                        <TextBlock x:Name="ToastText" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
