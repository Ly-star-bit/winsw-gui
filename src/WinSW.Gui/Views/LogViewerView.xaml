<UserControl
    x:Class="WinSW.Gui.Views.LogViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:LogViewerViewModel}"
    mc:Ignorable="d">

    <Grid Margin="28,24,28,20" Style="{StaticResource PageRoot}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Header. The service picker has a line of its own under the title: beside the
            cleanup and rescan controls, at 1024 px in Chinese, it was left less room than its
            own minimum width and lost its drop-down arrow. The directory gives way instead.
        -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="{DynamicResource S.Logs}" />
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" MinWidth="260" AutomationProperties.Name="{DynamicResource S.Service}" DisplayMemberPath="ServiceName" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource Mono}"
                    Text="{Binding LogDirectory}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding LogDirectory}" />
            </Grid>
            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <!-- What the service's logs come to here, and clearing out the old ones. -->
                <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource Mono}" Text="{Binding TotalSizeText}" />
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Log.KeepDays}" />
                <TextBox
                    Width="52"
                    Margin="0,0,8,0"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{DynamicResource M.Log.KeepDays}"
                    Text="{Binding KeepDays, UpdateSourceTrigger=PropertyChanged}" />
                <Button Margin="0,0,12,0" Padding="12,7" Command="{Binding CleanupCommand}" Content="{DynamicResource M.Log.Cleanup}" ToolTip="{DynamicResource M.Log.CleanupTip}" />
                <Button Padding="12,7" Command="{Binding RescanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xF13D;" />
                        <TextBlock Text="{DynamicResource S.RescanFiles}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--
            Toolbar, in two rows: which file is on screen and whether it moves, then how its
            lines are shown. As one row it came to about 1,300 px in Chinese against about
            966 px of card in the default window, and what gave way was the file picker, the
            only way between the .out, .err and wrapper logs: it shrank to nothing. Now it has
            whatever the first row leaves, the second row wraps rather than cuts off, and what
            is done with the file rather than the view is in the "…" menu. The check boxes drop
            the theme's 120 px minimum, which was most of their width for a two-character label.
        -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Row="0"
                    Grid.Column="0"
                    MinWidth="200"
                    DisplayMemberPath="Caption"
                    ItemsSource="{Binding Files}"
                    SelectedItem="{Binding SelectedFile}" />
                <Button Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" Padding="12,6" Command="{Binding TogglePauseCommand}" Content="{Binding PauseLabel}" />
                <CheckBox Grid.Row="0" Grid.Column="2" MinWidth="0" Margin="12,0,0,0" VerticalAlignment="Center" Content="{DynamicResource S.Follow}" IsChecked="{Binding AutoScroll}" />
                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    Padding="10,6"
                    AutomationProperties.Name="{DynamicResource M.Dash.More}"
                    Click="OnMoreClick"
                    ToolTip="{DynamicResource M.Dash.More}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE824;" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding OpenExternallyCommand}" Header="{DynamicResource S.Open2}" ToolTip="{DynamicResource S.OpenTheFileWithItsDefault}" />
                            <MenuItem Command="{Binding RevealCommand}" Header="{DynamicResource S.Reveal}" ToolTip="{DynamicResource S.ShowTheFileInExplorer}" />
                            <Separator />
                            <MenuItem Command="{Binding ClearCommand}" Header="{DynamicResource M.Log.ClearView}" ToolTip="{DynamicResource M.Log.ClearViewTip}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0" Orientation="Horizontal">
                    <ui:TextBox
                        Width="200"
                        Margin="0,4,8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource S.ShowOnlyLinesContainingThisText}"
                        PlaceholderText="{DynamicResource M.Ph.Filter}"
                        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{DynamicResource S.ShowOnlyLinesContainingThisText}">
                        <ui:TextBox.Style>
                            <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilterInvalid}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource HealthBrokenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBox.Style>
                    </ui:TextBox>
                    <CheckBox MinWidth="0" Margin="0,4,10,0" VerticalAlignment="Center" Content="{DynamicResource M.Log.Regex}" IsChecked="{Binding UseRegex}" />
                    <Button Margin="0,4,20,0" Padding="10,4" VerticalAlignment="Center" Command="{Binding NextErrorCommand}" ToolTip="{DynamicResource M.Log.NextErrorTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Foreground="{DynamicResource HealthBrokenBrush}" Style="{StaticResource Icon}" Text="&#xF869;" />
                            <TextBlock Text="{Binding ErrorCount}" />
                        </StackPanel>
                    </Button>
                    <!-- What detection settled on is in the tooltip; see EncodingToolTip. -->
                    <ComboBox
                        MinWidth="150"
                        Margin="0,4,12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource M.Log.Encoding}"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding Encodings}"
                        SelectedItem="{Binding SelectedEncoding}"
                        ToolTip="{Binding EncodingToolTip}" />
                    <CheckBox MinWidth="0" Margin="0,4,0,0" VerticalAlignment="Center" Content="{DynamicResource M.Log.Wrap}" IsChecked="{Binding WrapLines}" ToolTip="{DynamicResource M.Log.ZoomTip}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Output and events -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem x:Name="OutputTab" Header="{DynamicResource M.Log.OutputTab}">
                <Border Margin="0,8,0,0" Padding="0" Background="{DynamicResource InputBrush}" Style="{StaticResource Card}">
                    <ListBox
                        x:Name="Output"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="{DynamicResource MonoFont}"
                        FontSize="{Binding FontSize}"
                        ItemsSource="{Binding Lines}"
                        KeyDown="OnOutputKeyDown"
                        PreviewMouseWheel="OnOutputMouseWheel"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        SelectionMode="Extended"
                        ToolTip="{DynamicResource M.Log.CopyTip}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,1" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <!--
                            Each item is a LogLine, whose severity was worked out when it was read.
                            OneTime because a line never changes, so there is nothing to watch.
                            No Foreground on the element itself: a local value beats the triggers.
                        -->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text, Mode=OneTime}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                            <Setter Property="Foreground" Value="{DynamicResource LogInfoBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWarning, Mode=OneTime}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource LogWarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsError, Mode=OneTime}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.WrapLines, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>

            <TabItem Header="{DynamicResource M.Log.EventsTab}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource PageSubtitle}" Text="{Binding EventsStatus}" />
                        <Button Grid.Column="1" Padding="12,6" Command="{Binding RefreshEventsCommand}" Content="{DynamicResource M.Log.RefreshEvents}" />
                    </Grid>

                    <Border Grid.Row="1" Padding="0" Background="{DynamicResource InputBrush}" Style="{StaticResource Card}">
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Events}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Message}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Margin="0,0,10,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource HealthDot}">
                                                    <Setter Property="Fill" Value="{DynamicResource HealthRunningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource HealthPendingBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource HealthBrokenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Margin="0,0,14,0" Style="{StaticResource Mono}" Text="{Binding TimeText}" />
                                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Headline}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />

        <!-- Cleanup confirmation -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="4"
            Margin="-28,-24,-28,-20"
            Background="{DynamicResource OverlayBrush}"
            Focusable="True"
            Visibility="{Binding CleanupConfirmVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ConfirmCleanupCommand}" />
            </Grid.InputBindings>
            <Border MaxWidth="480" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource M.Log.CleanupTitle}" />
                    <TextBlock Margin="0,10,0,20" Style="{StaticResource PageSubtitle}" Text="{Binding CleanupMessage}" TextWrapping="Wrap" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="CleanupCancelButton" Margin="0,0,8,0" Padding="14,7" Command="{Binding CancelCleanupCommand}" Content="{DynamicResource S.Cancel}" />
                        <Button
                            Padding="14,7"
                            Background="{DynamicResource HealthBrokenBrush}"
                            Command="{Binding ConfirmCleanupCommand}"
                            Content="{DynamicResource M.Log.CleanupAction}"
                            Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
