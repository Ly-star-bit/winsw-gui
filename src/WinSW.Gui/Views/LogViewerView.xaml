<UserControl
    x:Class="WinSW.Gui.Views.LogViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:LogViewerViewModel}"
    mc:Ignorable="d">

    <Grid Margin="28,24,28,20" Style="{StaticResource PageRoot}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Logs}" />
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding ServiceName}" />
                    <TextBlock Margin="10,0" Style="{StaticResource PageSubtitle}" Text="·" />
                    <TextBlock Style="{StaticResource Mono}" Text="{Binding LogDirectory}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Padding="12,7" Command="{Binding RescanCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xE72C;" />
                    <TextBlock Text="{DynamicResource S.RescanFiles}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    MinWidth="320"
                    HorizontalAlignment="Left"
                    DisplayMemberPath="Caption"
                    ItemsSource="{Binding Files}"
                    SelectedItem="{Binding SelectedFile}" />

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBox
                        Width="200"
                        AutomationProperties.Name="{DynamicResource S.ShowOnlyLinesContainingThisText}"
                        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{DynamicResource S.ShowOnlyLinesContainingThisText}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilterInvalid}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource HealthBrokenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <CheckBox Margin="8,0,0,0" VerticalAlignment="Center" Content="{DynamicResource M.Log.Regex}" IsChecked="{Binding UseRegex}" />
                    <Button Margin="10,0,0,0" Padding="10,4" Command="{Binding NextErrorCommand}" ToolTip="{DynamicResource M.Log.NextErrorTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" Foreground="{DynamicResource HealthBrokenBrush}" Style="{StaticResource Icon}" Text="&#xE7BA;" />
                            <TextBlock Text="{Binding ErrorCount}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <ComboBox MinWidth="150" DisplayMemberPath="Label" ItemsSource="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding}" ToolTip="{DynamicResource M.Log.Encoding}" />
                    <TextBlock Margin="10,0,12,0" VerticalAlignment="Center" Style="{StaticResource Mono}" Text="{Binding EncodingInfo}" />
                    <CheckBox VerticalAlignment="Center" Content="{DynamicResource S.Follow}" IsChecked="{Binding AutoScroll}" />
                </StackPanel>

                <Button Grid.Column="3" Margin="0,0,8,0" Padding="12,6" Command="{Binding TogglePauseCommand}" Content="{Binding PauseLabel}" />
                <Button Grid.Column="4" Margin="0,0,8,0" Padding="12,6" Command="{Binding ClearCommand}" Content="{DynamicResource S.Clear}" />
                <Button Grid.Column="5" Margin="0,0,8,0" Padding="12,6" Command="{Binding OpenExternallyCommand}" Content="{DynamicResource S.Open2}" ToolTip="{DynamicResource S.OpenTheFileWithItsDefault}" />
                <Button Grid.Column="6" Padding="12,6" Command="{Binding RevealCommand}" Content="{DynamicResource S.Reveal}" ToolTip="{DynamicResource S.ShowTheFileInExplorer}" />
            </Grid>
        </Border>

        <!-- Output and events -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="{DynamicResource M.Log.OutputTab}">
                <Border Margin="0,8,0,0" Padding="0" Background="{DynamicResource InputBrush}" Style="{StaticResource Card}">
                    <ListBox
                        x:Name="Output"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="{DynamicResource MonoFont}"
                        FontSize="12"
                        ItemsSource="{Binding Lines}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,1" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Foreground="{Binding Converter={StaticResource LogSeverityToBrush}}"
                                    Text="{Binding}"
                                    TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>

            <TabItem Header="{DynamicResource M.Log.EventsTab}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource PageSubtitle}" Text="{Binding EventsStatus}" />
                        <Button Grid.Column="1" Padding="12,6" Command="{Binding RefreshEventsCommand}" Content="{DynamicResource M.Log.RefreshEvents}" />
                    </Grid>

                    <Border Grid.Row="1" Padding="0" Background="{DynamicResource InputBrush}" Style="{StaticResource Card}">
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Events}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Message}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Margin="0,0,10,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource HealthDot}">
                                                    <Setter Property="Fill" Value="{DynamicResource HealthRunningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource HealthPendingBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource HealthBrokenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Margin="0,0,14,0" Style="{StaticResource Mono}" Text="{Binding TimeText}" />
                                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Headline}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
