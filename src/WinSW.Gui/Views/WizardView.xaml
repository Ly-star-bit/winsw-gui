<UserControl
    x:Class="WinSW.Gui.Views.WizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:WinSW.Gui.Controls"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:WizardViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Content" Value="…" />
        </Style>

        <!-- A step panel is visible only while the wizard is on that step. -->
        <Style x:Key="StepPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,20,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20" Style="{StaticResource PageRoot}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.NewService}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitle}" Text="{DynamicResource S.TurnAnyProgramIntoAWindows}" />
        </StackPanel>

        <!-- Step indicator: the dot for the current step is filled with the accent. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18" Orientation="Horizontal">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="1">
                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="1" />
            </Border>
            <TextBlock Style="{StaticResource StepLabel}" Text="{DynamicResource S.Program}" />
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="2">
                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="2" />
            </Border>
            <TextBlock Style="{StaticResource StepLabel}" Text="{DynamicResource S.Identity}" />
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="3">
                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="3" />
            </Border>
            <TextBlock Style="{StaticResource StepLabel}" Text="{DynamicResource S.LoggingRecovery}" />
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="4">
                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="4" />
            </Border>
            <TextBlock Style="{StaticResource StepLabel}" Text="{DynamicResource S.Install}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Step 1: program -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,16" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StepTitle}" />

                        <!-- How the program is hosted. Everything downstream follows from this. -->
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Wiz.HostMode}" />
                            <RadioButton Margin="0,2,0,0" GroupName="HostMode" IsChecked="{Binding DesktopTask, Converter={StaticResource InverseBool}}" Content="{DynamicResource M.Wiz.HostService}" />
                            <TextBlock Margin="24,0,0,6" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{DynamicResource M.Wiz.HostServiceHint}" />
                            <RadioButton GroupName="HostMode" IsChecked="{Binding DesktopTask, Mode=TwoWay}" Content="{DynamicResource M.Wiz.HostDesktop}" />
                            <TextBlock Margin="24,0,0,0" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{DynamicResource M.Wiz.HostDesktopHint}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Wiz.CloneFrom}" />
                            <ComboBox HorizontalAlignment="Left" MinWidth="320" DisplayMemberPath="DisplayName" ItemsSource="{Binding Sources}" SelectedItem="{Binding CloneSource}" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource M.Wiz.CloneHint}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.ProgramToRun}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding BrowseTargetCommand}" />
                                <ui:TextBox PlaceholderText="{DynamicResource M.Ph.Program}" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.WinSWExecutable}" />
                            <CheckBox Margin="0,0,0,4" Content="{DynamicResource M.Wiz.UseBundled}" IsChecked="{Binding UseBundledWrapper}" Visibility="{Binding HasBundledWrapper, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="{Binding BundledWrapperHint}" Visibility="{Binding UseBundledWrapper, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Visibility="{Binding UseBundledWrapper, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding BrowseWrapperCommand}" />
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,0" Command="{Binding DownloadWrapperCommand}" Content="{DynamicResource M.Wiz.Download}" ToolTip="{DynamicResource M.Wiz.DownloadTip}" />
                                    <ui:TextBox PlaceholderText="{DynamicResource M.Ph.Wrapper}" Text="{Binding WrapperPath, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource M.Wiz.WrapperHint}" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Margin="0,0,0,4" Content="{DynamicResource M.Wiz.PlaceNextToProgram}" IsChecked="{Binding PlaceNextToProgram}" />
                        <TextBlock Margin="0,0,0,8" MaxWidth="640" HorizontalAlignment="Left" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{DynamicResource M.Wiz.LayoutHint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0" Text="{DynamicResource M.Wiz.InstallDir}" />
                            <TextBlock Style="{StaticResource Mono}" Margin="6,0,0,0" Text="{Binding InstallDirectory}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0" Text="{DynamicResource M.Wiz.WrapperAt}" />
                            <TextBlock Style="{StaticResource Mono}" Margin="6,0,0,0" Text="{Binding EffectiveWrapperPath}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Arguments}" />
                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.WorkingDirectory}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding BrowseWorkingDirectoryCommand}" />
                                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <CheckBox Margin="0,4,0,6" Content="{DynamicResource M.Wiz.Brand}" IsChecked="{Binding BrandWrapper}" />
                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding BrandWrapper, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Wiz.Manufacturer}" />
                            <TextBox HorizontalAlignment="Left" MinWidth="320" Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0" Text="{DynamicResource M.Wiz.BrandHint}" />
                                <TextBlock Style="{StaticResource Mono}" Margin="6,0,0,0" Text="{Binding EffectiveWrapperPath}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 2: identity -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="2">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,16" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StepTitle}" />
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.ServiceID}" />
                            <ui:TextBox PlaceholderText="{DynamicResource M.Ph.ServiceId}" Text="{Binding ServiceId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Foreground="{DynamicResource HealthBrokenBrush}" Text="{DynamicResource M.Wiz.IdInUseHint}" Visibility="{Binding IdInUse, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.NoSpacesAlsoBecomesTheConfiguration}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.DisplayName}" />
                            <ui:TextBox PlaceholderText="{DynamicResource M.Ph.DisplayName}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.Description}" />
                            <TextBox AcceptsReturn="True" MinHeight="64" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsService, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.StartMode}" />
                                <ComboBox HorizontalAlignment="Left" MinWidth="200" ItemsSource="{Binding StartModes}" SelectedItem="{Binding StartMode}" />
                            </StackPanel>
                            <CheckBox Content="{DynamicResource S.DelayedAutomaticStart}" IsChecked="{Binding DelayedAutoStart}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding DesktopTask, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Wiz.RunsAs}" />
                                <TextBlock Style="{StaticResource Mono}" Text="{Binding TaskAccount}" />
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{DynamicResource M.Wiz.RunsAsHint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Wiz.LogonDelay}" />
                                <controls:DurationEditor Value="{Binding LogonDelay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{DynamicResource M.Wiz.LogonDelayHint}" />
                            </StackPanel>
                            <CheckBox Content="{DynamicResource M.Wiz.RunElevated}" IsChecked="{Binding RunElevated}" />
                            <TextBlock Margin="24,2,0,0" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{DynamicResource M.Wiz.RunElevatedHint}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 3: logging & recovery -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="3">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,16" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StepTitle}" />
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.LogMode}" />
                            <ComboBox HorizontalAlignment="Left" MinWidth="200" ItemsSource="{Binding LogModes}" SelectedItem="{Binding LogMode}" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="{DynamicResource S.RollBySizeKeepsABounded}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,16" Visibility="{Binding UsesSizeRolling, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.RollAfterKB}" />
                                <TextBox Text="{Binding SizeThresholdKb, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.FilesToKeep}" />
                                <TextBox Text="{Binding KeepFiles, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.LogDirectoryOptional}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding BrowseLogPathCommand}" />
                                <TextBox Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsService, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Margin="0,4,0,8" Content="{DynamicResource S.RestartTheServiceAutomaticallyWhenThe}" IsChecked="{Binding RestartOnFailure}" />
                            <StackPanel Style="{StaticResource Field}" IsEnabled="{Binding RestartOnFailure}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource S.RestartDelay}" />
                                <controls:DurationEditor Value="{Binding RestartDelay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding DesktopTask, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Margin="0,4,0,4" Content="{DynamicResource M.Wiz.KeepAlive}" IsChecked="{Binding RestartOnFailure}" />
                            <TextBlock Margin="24,0,0,8" MaxWidth="600" HorizontalAlignment="Left" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Text="{DynamicResource M.Wiz.KeepAliveHint}" />
                            <StackPanel Style="{StaticResource Field}" IsEnabled="{Binding RestartOnFailure}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource M.Wiz.KeepAliveInterval}" />
                                <controls:DurationEditor Value="{Binding KeepAliveInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 4: review -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                                <Setter Property="MaxWidth" Value="900" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="4">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,6" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding StepTitle}" />
                        <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,8,0" Text="{DynamicResource S.WillBeWrittenTo}" />
                            <TextBlock Style="{StaticResource Mono}" Text="{Binding ConfigPath}" />
                        </StackPanel>

                        <Border Margin="0,0,0,14" Padding="12,10" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource HealthBrokenBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding Problems.Count, Converter={StaticResource CountToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Padding="0" Background="{DynamicResource InputBrush}" Style="{StaticResource Card}">
                            <TextBox
                                MaxHeight="360"
                                Margin="6"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="{DynamicResource MonoFont}"
                                FontSize="12"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Text="{Binding ConfigPreview, Mode=OneWay}"
                                VerticalScrollBarVisibility="Auto" />
                        </Border>

                        <CheckBox Margin="0,16,0,0" Content="{DynamicResource S.StartTheServiceAfterInstalling}" IsChecked="{Binding StartAfterInstall}" Visibility="{Binding IsService, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox Margin="0,16,0,0" Content="{DynamicResource M.Wiz.StartAfterRegister}" IsChecked="{Binding StartAfterInstall}" Visibility="{Binding DesktopTask, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" Width="90" Height="4" Margin="0,0,12,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Padding="12,7" Command="{Binding ResetCommand}" Content="{DynamicResource S.StartOver}" />
                <Button Margin="0,0,8,0" Padding="12,7" Command="{Binding BackCommand}" Content="{DynamicResource S.Back}" />
                <Button Padding="14,7" Command="{Binding NextCommand}" Content="{DynamicResource S.Next}" Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Padding="14,7" Background="{DynamicResource AccentGradientBrush}" Foreground="White" Command="{Binding InstallCommand}" Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Foreground="White" Style="{StaticResource Icon}" Text="&#xE768;" />
                        <TextBlock Text="{Binding InstallLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
