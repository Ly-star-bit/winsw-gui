<UserControl
    x:Class="WinSW.Gui.Views.WizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:WizardViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Content" Value="…" />
        </Style>

        <!-- A step panel is visible only while the wizard is on that step. -->
        <Style x:Key="StepPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,20,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20" Style="{StaticResource PageRoot}">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource PageTitle}" Text="New service" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitle}" Text="Turn any program into a Windows service. The wizard writes the configuration and installs it." />
        </StackPanel>

        <!-- Step indicator: the dot for the current step is filled with the accent. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18" Orientation="Horizontal">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="1">
                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="1" />
            </Border>
            <TextBlock Style="{StaticResource StepLabel}" Text="Program" />
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="2">
                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="2" />
            </Border>
            <TextBlock Style="{StaticResource StepLabel}" Text="Identity" />
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="3">
                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="3" />
            </Border>
            <TextBlock Style="{StaticResource StepLabel}" Text="Logging &amp; recovery" />
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StepDot}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="4">
                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="4" />
            </Border>
            <TextBlock Style="{StaticResource StepLabel}" Text="Install" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Step 1: program -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,16" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding StepTitle}" />
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="WinSW executable" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding BrowseWrapperCommand}" />
                                <TextBox Text="{Binding WrapperPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource FieldHint}" Text="The configuration file is written next to this executable and registered with it. Copy WinSW.exe to where the service should live before choosing it." />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Program to run" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding BrowseTargetCommand}" />
                                <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Arguments" />
                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Working directory" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding BrowseWorkingDirectoryCommand}" />
                                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 2: identity -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="2">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,16" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding StepTitle}" />
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Service ID" />
                            <TextBox Text="{Binding ServiceId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="No spaces. Also becomes the configuration file name." />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Display name" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                            <TextBox AcceptsReturn="True" MinHeight="64" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Start mode" />
                            <ComboBox HorizontalAlignment="Left" MinWidth="200" ItemsSource="{Binding StartModes}" SelectedItem="{Binding StartMode}" />
                        </StackPanel>
                        <CheckBox Content="Delayed automatic start" IsChecked="{Binding DelayedAutoStart}" />
                    </StackPanel>

                    <!-- Step 3: logging & recovery -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="3">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,16" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding StepTitle}" />
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Log mode" />
                            <ComboBox HorizontalAlignment="Left" MinWidth="200" ItemsSource="{Binding LogModes}" SelectedItem="{Binding LogMode}" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="roll-by-size keeps a bounded number of files and is the safe default for long-running services." />
                        </StackPanel>
                        <Grid Margin="0,0,0,16" Visibility="{Binding UsesSizeRolling, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Roll after (KB)" />
                                <TextBox Text="{Binding SizeThresholdKb, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Files to keep" />
                                <TextBox Text="{Binding KeepFiles, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Log directory (optional)" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Command="{Binding BrowseLogPathCommand}" />
                                <TextBox Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <CheckBox Margin="0,4,0,8" Content="Restart the service automatically when the program crashes" IsChecked="{Binding RestartOnFailure}" />
                        <StackPanel Style="{StaticResource Field}" IsEnabled="{Binding RestartOnFailure}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Restart delay" />
                            <TextBox HorizontalAlignment="Left" MinWidth="200" Text="{Binding RestartDelay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 4: review -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                                <Setter Property="MaxWidth" Value="900" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="4">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,6" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding StepTitle}" />
                        <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,8,0" Text="Will be written to" />
                            <TextBlock Style="{StaticResource Mono}" Text="{Binding ConfigPath}" />
                        </StackPanel>

                        <Border Margin="0,0,0,14" Padding="12,10" Background="#2A1B1F" BorderBrush="{StaticResource HealthBrokenBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding Problems.Count, Converter={StaticResource CountToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Padding="0" Background="{StaticResource InputBrush}" Style="{StaticResource Card}">
                            <TextBox
                                MaxHeight="360"
                                Margin="6"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="{StaticResource MonoFont}"
                                FontSize="12"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Text="{Binding ConfigPreview, Mode=OneWay}"
                                VerticalScrollBarVisibility="Auto" />
                        </Border>

                        <CheckBox Margin="0,16,0,0" Content="Start the service after installing" IsChecked="{Binding StartAfterInstall}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" Width="90" Height="4" Margin="0,0,12,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PageSubtitle}" Text="{Binding StatusMessage}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Padding="12,7" Command="{Binding ResetCommand}" Content="Start over" />
                <Button Margin="0,0,8,0" Padding="12,7" Command="{Binding BackCommand}" Content="Back" />
                <Button Padding="14,7" Command="{Binding NextCommand}" Content="Next" Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Padding="14,7" Background="{StaticResource AccentGradientBrush}" Foreground="White" Command="{Binding InstallCommand}" Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Foreground="White" Style="{StaticResource Icon}" Text="&#xE768;" />
                        <TextBlock Text="Install" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
