<ui:FluentWindow
    x:Class="WinSW.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    mc:Ignorable="d"
    Title="WinSW"
    Width="1280"
    Height="820"
    MinWidth="960"
    MinHeight="600"
    Background="{DynamicResource SurfaceBrush}"
    FontFamily="{DynamicResource BodyFont}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Dashboard.ReloadCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Editor.SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Dashboard.CancelConfirmCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WinSW" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Margin="22,18,22,22" Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="{DynamicResource AccentGradientBrush}" CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="White" Style="{StaticResource Icon}" Text="&#xE770;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="WinSW" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource S.ServiceWrapper}" />
                                <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding GuiVersion}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <ListBox
                        Grid.Row="1"
                        AutomationProperties.Name="Navigation"
                        ItemContainerStyle="{StaticResource NavItem}"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem}"
                        Style="{StaticResource NavList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="22" FontSize="16" Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Preferences and elevation state -->
                    <StackPanel Grid.Row="2" Margin="14,0,14,14">
                        <StackPanel.Resources>
                            <Style x:Key="PrefLabel" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                            </Style>
                        </StackPanel.Resources>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource PrefLabel}" Text="{DynamicResource M.Shell.Language}" />
                            <ComboBox Grid.Column="1" DisplayMemberPath="NativeName" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource PrefLabel}" Text="{DynamicResource M.Shell.Theme}" />
                            <ComboBox Grid.Column="1" DisplayMemberPath="Label" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                        </Grid>

                        <CheckBox Margin="0,0,0,4" FontSize="12" Content="{DynamicResource M.Shell.MinimizeToTray}" IsChecked="{Binding MinimizeToTray}" />
                        <CheckBox Margin="0,0,0,4" FontSize="12" Content="{DynamicResource M.Shell.NotifyOnStop}" IsChecked="{Binding NotifyOnUnexpectedStop}" />
                        <CheckBox Margin="0,0,0,10" FontSize="12" Content="{DynamicResource M.Shell.ContextMenu}" IsChecked="{Binding ContextMenuRegistered}" ToolTip="{DynamicResource M.Shell.ContextMenuTip}" />

                        <!-- Newer GUI release available -->
                        <Border Margin="0,0,0,8" Padding="12,8" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding HasGuiUpdate, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding GuiUpdateText}" TextWrapping="Wrap" />
                                <Button Margin="0,6,0,0" HorizontalAlignment="Left" Padding="10,4" Command="{Binding OpenGuiUpdateCommand}" Content="{DynamicResource M.Shell.OpenRelease}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="12,10" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xE7EF;" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ElevationLabel}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ElevationHint}" TextWrapping="Wrap" />
                                <Button
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"
                                    Padding="10,6"
                                    Command="{Binding RestartElevatedCommand}"
                                    Content="{DynamicResource M.Shell.RestartElevated}"
                                    Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host: DataTemplates in App.xaml map each view model to its view. -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
