<ui:FluentWindow
    x:Class="WinSW.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    mc:Ignorable="d"
    Title="WinSW"
    Icon="/Assets/WinSW.Gui.ico"
    Width="1280"
    Height="820"
    MinWidth="960"
    MinHeight="600"
    Background="{DynamicResource SurfaceBrush}"
    FontFamily="{DynamicResource BodyFont}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Dashboard.ReloadCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Editor.SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Dashboard.CancelConfirmCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WinSW" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail: 232 px with labels, 72 px icon-only -->
            <Border Grid.Column="0" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="232" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRailCollapsed}" Value="True">
                                <Setter Property="Width" Value="72" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand + collapse toggle -->
                    <Grid Grid.Row="0" Margin="18,14,12,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="{DynamicResource AccentGradientBrush}" CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="White" Style="{StaticResource Icon}" Text="&#xE770;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsRailCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="WinSW" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{DynamicResource S.ServiceWrapper}" />
                                <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding GuiVersion}" />
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Padding="6,4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource M.Settings.CollapseRail}"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleRailCommand}"
                            ToolTip="{DynamicResource M.Settings.CollapseRail}"
                            Visibility="{Binding IsRailCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE700;" />
                        </Button>
                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        AutomationProperties.Name="Navigation"
                        ItemContainerStyle="{StaticResource NavItem}"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem}"
                        Style="{StaticResource NavList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                    <TextBlock Width="22" FontSize="16" Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                                    <StackPanel Margin="10,0,0,0" Visibility="{Binding DataContext.IsRailCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Elevation state; preferences live on the Settings page -->
                    <StackPanel Grid.Row="2" Margin="14,0,14,14">
                        <Button
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            Padding="8,6"
                            AutomationProperties.Name="{DynamicResource M.Settings.ExpandRail}"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ToggleRailCommand}"
                            ToolTip="{DynamicResource M.Settings.ExpandRail}"
                            Visibility="{Binding IsRailCollapsed, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE700;" />
                        </Button>

                        <Border Padding="12,10" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" ToolTip="{Binding ElevationHint}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" />
                                    <TextBlock Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ElevationLabel}" Visibility="{Binding IsRailCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ElevationHint}" TextWrapping="Wrap" Visibility="{Binding IsRailCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Button
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"
                                    Padding="10,6"
                                    Command="{Binding RestartElevatedCommand}"
                                    Content="{DynamicResource M.Shell.RestartElevated}"
                                    Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRailCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host: DataTemplates in App.xaml map each view model to its view. -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentPage}" />

                <!-- Transient notice for the outcome of an action; sits where the eye already is. -->
                <Border
                    MaxWidth="520"
                    Margin="0,16,28,0"
                    Padding="14,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource CardBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource HealthRunningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource HealthBrokenBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.35" ShadowDepth="2" />
                    </Border.Effect>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ToastText}" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
