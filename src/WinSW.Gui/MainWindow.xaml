<ui:FluentWindow
    x:Class="WinSW.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    mc:Ignorable="d"
    Title="WinSW"
    Width="1280"
    Height="820"
    MinWidth="960"
    MinHeight="600"
    Background="{StaticResource SurfaceBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WinSW" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Margin="22,18,22,22" Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="{StaticResource AccentGradientBrush}" CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="White" Style="{StaticResource Icon}" Text="&#xE770;" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="WinSW" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="Service Wrapper" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox
                        Grid.Row="1"
                        ItemContainerStyle="{StaticResource NavItem}"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem}"
                        Style="{StaticResource NavList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="22" FontSize="16" Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Title}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Elevation state -->
                    <Border Grid.Row="2" Margin="14" Padding="12,10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" Style="{StaticResource Icon}" Text="&#xE7EF;" />
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding ElevationLabel}" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding ElevationHint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Page host: DataTemplates in App.xaml map each view model to its view. -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
