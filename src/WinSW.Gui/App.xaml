<Application
    x:Class="WinSW.Gui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:WinSW.Gui.ViewModels"
    xmlns:views="clr-namespace:WinSW.Gui.Views"
    StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI: Fluent implicit styles for the standard controls, dark theme. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />

                <!-- Ours: palette, cards, rail, pills, page transitions. -->
                <ResourceDictionary Source="Theme/Palette.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />

                <!-- UI strings. Localizer swaps this entry at runtime for the chosen language. -->
                <ResourceDictionary Source="Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- View model → view. The shell's ContentControl resolves pages through these. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfigEditorViewModel}">
                <views:ConfigEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogViewerViewModel}">
                <views:LogViewerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WizardViewModel}">
                <views:WizardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RemoteViewModel}">
                <views:RemoteView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
